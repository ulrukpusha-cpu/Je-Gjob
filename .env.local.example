# Copier ce fichier en .env.local et remplir les valeurs.
# .env.local est ignore par git - c'est LA SEULE place ou mettre des vraies cles localement.
# Pour la prod, les cles vont dans Supabase Dashboard > Edge Functions > Secrets
# (et dans Vercel > Settings > Environment Variables pour les VITE_*).
#
# NE JAMAIS coller de vraies cles dans CE fichier .env.local.example - il finit sur GitHub.

# ==== Frontend (Vercel + dev local) ====
# Supabase : Settings > API dans le dashboard Supabase
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ==== Bot Telegram local (npm run bot) - DEPRECATED, en prod c'est l'Edge Function ====
# IA Kimi (Moonshot OU NVIDIA NIM - le bot detecte le format de la cle)
# - Moonshot : cle commence par "sk-..." -> KIMI_BASE_URL=https://api.moonshot.ai/v1
# - NVIDIA   : cle commence par "nvapi-..." -> KIMI_BASE_URL=https://integrate.api.nvidia.com/v1
KIMI_API_KEY=
KIMI_MODEL=
KIMI_BASE_URL=

# IA Anthropic (fallback si Kimi rate)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Provider IA frontend (kimi | anthropic)
VITE_AI_PROVIDER=kimi

# Telegram / paiements
TELEGRAM_BOT_TOKEN=
TELEGRAM_PREMIUM_INVOICE_SLUG=
TELEGRAM_PAYMENT_PROVIDER_TOKEN=
DJAMO_PAYMENT_URL=
WAVE_QR_URL=
ADMIN_SECRET=
